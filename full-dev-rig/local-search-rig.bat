  ) else (
    echo.
    echo Building installers with !PY! ...
    pushd "!TARGET!"
    !PY! gen_installers.py
    if errorlevel 1 (
      popd
      echo   [ERROR] gen_installers.py failed.
      pause
      exit /b 1
    )
    popd
    echo   Installers written to !TARGET!\local-search\
  )
)

